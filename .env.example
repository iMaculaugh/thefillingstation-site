# Names only. Set real values in Netlify > Site configuration > Environment variables.
# Mark keys as secret. Never commit real values.
# STRIPE_SECRET_KEY should be a restricted key (rk_test_… or rk_live_…), not a publishable key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SITE_URL=https://thefillingstationchurch.org
# Optional (defaults shown)
DONATION_CURRENCY=usd
DONATION_MIN_CENTS=100
DONATION_MAX_CENTS=1000000
ALLOWED_ORIGINS=
DONATIONS_BLOB_STORE=donations
# ALLOW_LOCALHOST=true
